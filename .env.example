# =========================================================
# .env untuk docker-compose (letakkan di root project, sejajar dengan docker-compose.yml)
# Copy jadi ".env" lalu sesuaikan nilainya. JANGAN commit file ".env" hasil copy ke Git.
# =========================================================

# --- Dipakai oleh service mysql & backend ---
DB_NAME=silapor
DB_PASSWORD=ganti-dengan-password-mysql-yang-kuat

# --- Dipakai oleh service backend (port mapping host:container) ---
APP_PORT=8081

# --- Dipakai saat build image frontend (VITE_API_BASE_URL di-inline ke hasil build) ---
# Ganti sesuai domain/IP VPS kamu, contoh: https://api.domainkamu.com/api/v1
VITE_API_BASE_URL=http://localhost:8081/api/v1
