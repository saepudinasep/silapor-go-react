# =========================
# APP CONFIG
# =========================
APP_NAME=silapor-api
APP_PORT=8080
APP_ENV=local

# =========================
# DATABASE CONFIG (MySQL)
# =========================
# --- Untuk MySQL lokal (development) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=silapor
DB_CHARSET=utf8mb4
DB_SSL_MODE=disable

# --- Untuk Aiven MySQL (production), ganti nilai di atas menjadi seperti berikut ---
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=silapor
# DB_CHARSET=utf8mb4
# DB_SSL_MODE=skip-verify
# # Opsi lebih aman (verifikasi CA certificate penuh):
# # DB_SSL_MODE=verify-ca
# # DB_SSL_CA_PATH=certs/aiven-ca.pem

# =========================
# JWT CONFIG
# =========================
JWT_SECRET=change-this-to-a-very-long-random-secret
JWT_EXPIRES_HOURS=24

# =========================
# UPLOAD
# =========================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# =========================
# SEEDER
# =========================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345