# =========================
# JWT CONFIG
# =========================
JWT_SECRET=change-this-to-a-very-long-random-secret
JWT_EXPIRES_HOURS=24

# =========================
# SEEDER
# =========================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
