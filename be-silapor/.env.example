# =========================
# APP CONFIG
# =========================
APP_NAME=silapor-go-react
APP_PORT=8080
APP_ENV=local

# =========================
# DATABASE CONFIG (MySQL)
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=silapor-go-react
