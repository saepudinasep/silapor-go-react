# =========================
# APP CONFIG
# =========================
APP_NAME=silapor-api
APP_PORT=8080
APP_ENV=local

# =========================
# DATABASE CONFIG (MySQL)
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=silapor
DB_CHARSET=utf8mb4

# =========================
# JWT CONFIG
# =========================
JWT_SECRET=change-this-to-a-very-long-random-secret
JWT_EXPIRES_HOURS=24

# =========================
# UPLOAD
# =========================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# =========================
# SEEDER
# =========================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345